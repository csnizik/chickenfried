<?php

/**
 * Add missing base-field columns for SheepRecord (Julian + disposal).
 */
function sheep_entities_update_9001() {
  $entity_type_id = 'sheep_entities_sheep_record';
  $provider = 'sheep_entities';
  $manager = \Drupal::entityDefinitionUpdateManager();
  $base_defs = \Drupal::service('entity_field.manager')->getBaseFieldDefinitions($entity_type_id);

  $fields_to_add = [
    'field_s_born_day_julian',
    'field_s_born_year',
    'field_s_disposal_day_julian',
    'field_s_disposal_year',
  ];

  foreach ($fields_to_add as $field_name) {
    if (!isset($base_defs[$field_name])) {
      throw new \RuntimeException(sprintf('Base field %s is not defined in code.', $field_name));
    }
    try {
      // Adds the column if missing; no-ops if it already exists.
      $manager->installFieldStorageDefinition($field_name, $entity_type_id, $provider, $base_defs[$field_name]);
    }
    catch (\Drupal\Core\Entity\EntityStorageException $e) {
      // Ignore "already exists" style errors to keep it idempotent.
      if (stripos($e->getMessage(), 'already exists') === false) {
        throw $e;
      }
    }
  }
}

