  <section{{ attributes.addClass('usa-hero').setAttribute('aria-label', aria_label|default('Introduction')) }}> #}

{# {% set bg_url = file_url(bg_image) %} #}

{# <section style="background-image: url('{{ bg_url|e('html_attr') }}'); background-size: cover; background-repeat: no-repeat;"> #}
<section style="background-image: url('{{ bg_image }}'); background-size: cover; background-repeat: no-repeat; background-position: center;">
  <div class="grid-container padding-y-4">
    <div class="usa-hero__callout maxw-mobile-lg">
    {# The span with alternate color "Resilient Future" is done in the field value in the component #}
      <h1 class="usa-hero__heading text-white ars-heading">
        {% if title_alt %}
          <span class="usa-hero__heading--alt">
            {{ title_alt }}
          </span>
        {% endif %}
        {{ title }}
      </h1>
      {{ body }}
    </div>
  </div>
</section>
