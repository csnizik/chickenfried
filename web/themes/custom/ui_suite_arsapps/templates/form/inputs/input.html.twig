{#
/**
 * @file
 * Default theme implementation for an 'input' #type form element.
 *
 * Available variables:
 * - attributes: A list of HTML attributes for the input element.
 * - children: Optional additional rendered elements.
 * - icon: An icon.
 * - input_group: Flag to display as an input group.
 * - icon_position: Where an icon should be displayed.
 * - prefix: Markup to display before the input element.
 * - suffix: Markup to display after the input element.
 * - type: The type of input.
 *
 * @ingroup templates
 *
 * @see template_preprocess_input()
 */
#}

{# If this input participates in an input group, wrap with the USWDS group. #}
{% if input_group %}
  <div class="usa-input-group">
{% endif %}

{% if prefix %}
  <span class="usa-input-prefix">{{ prefix }}</span>
{% endif %}

{% block input %}
  {#
    Ensure USWDS base input styling. Keep any existing classes,
    just append "usa-input".
  #}
  <input{{ attributes.addClass('usa-input') }} />
{% endblock %}

{% if suffix %}
  <span class="usa-input-suffix">{{ suffix }}</span>
{% endif %}

{% if input_group %}
  </div>
{% endif %}

{{ children }}
