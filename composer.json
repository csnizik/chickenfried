{
  "name": "drupal/recommended-project",
  "description": "Project template for Drupal projects with a relocated document root",
  "type": "project",
  "license": "GPL-2.0-or-later",
  "homepage": "https://www.drupal.org/project/drupal",
  "support": {
    "docs": "https://www.drupal.org/docs/user_guide/en/index.html",
    "chat": "https://www.drupal.org/node/314178"
  },
  "asset-packagist": {
    "type": "composer",
    "url": "https://asset-packagist.org"
  },
  "repositories": [
    {
      "type": "composer",
      "url": "https://packages.drupal.org/8"
    },
    {
      "type": "composer",
      "url": "https://asset-packagist.org"
    }
  ],
  "require": {
    "composer/installers": "^2.3",
    "cweagans/composer-patches": "^2.0",
    "drupal/admin_toolbar": "^3.6",
    "drupal/auto_entitylabel": "^3.4",
    "drupal/better_exposed_filters": "^7.0",
    "drupal/charts": "^5.1",
    "drupal/config_ignore": "^3.3",
    "drupal/core-composer-scaffold": "^11.3",
    "drupal/core-project-message": "^11.2",
    "drupal/core-recipe-unpack": "^11.2",
    "drupal/core-recommended": "^11.3",
    "drupal/csv_serialization": "^4.0",
    "drupal/dashboards": "^2.1",
    "drupal/devel": "^5.4",
    "drupal/devel_entity_updates": "^5.0@RC",
    "drupal/easy_breadcrumb": "^2.0",
    "drupal/editoria11y": "^2.2",
    "drupal/entity_updater": "^1.0",
    "drupal/feeds": "^3.0",
    "drupal/feeds_tamper": "^2.0@beta",
    "drupal/field_permissions": "^1.4",
    "drupal/gin": "^5.0",
    "drupal/gin_toolbar": "^3.0",
    "drupal/gin_toolbar_custom_menu": "^1.0",
    "drupal/group": "^3.3",
    "drupal/group_content_menu": "^3.0",
    "drupal/group_term": "^4.1",
    "drupal/groupmedia": "^4.0",
    "drupal/health_check": "^3.1",
    "drupal/login_redirect_per_role": "^1.11",
    "drupal/media_entity_download": "^2.4",
    "drupal/migmag": "^1.8",
    "drupal/migrate_child_entity_generate": "^1.0",
    "drupal/migrate_conditions": "^2.2",
    "drupal/migrate_plus": "^6.0",
    "drupal/migrate_source_csv": "^3.7",
    "drupal/migrate_tools": "^6.1",
    "drupal/openid_connect_windows_aad": "^2.0@beta",
    "drupal/paragraphs": "^1.19",
    "drupal/pathauto": "^1.13",
    "drupal/pdf_reader": "^1.2",
    "drupal/search_api": "^1.38",
    "drupal/selective_better_exposed_filters": "^3.0",
    "drupal/sitewide_alert": "^3.0",
    "drupal/tamper": "^1.0@beta",
    "drupal/token": "^1.15",
    "drupal/ui_examples": "^1.0",
    "drupal/ui_skins": "^1.1@alpha",
    "drupal/ui_suite_uswds": "^4.0",
    "drupal/ui_suite_uswds_extras": "^4.0",
    "drupal/ui_suite_uswds_paragraphs": "^4.0",
    "drupal/views_aggregator": "^2.1",
    "drupal/views_bulk_operations": "^4.3",
    "drupal/views_computed_field": "^1.0",
    "drupal/views_data_export": "^1.6",
    "drupal/views_simple_math_field": "^3.0",
    "drupal/views_year_filter": "^2.1",
    "drupal/webform": "^6.2",
    "drupal/webform_group": "^3.0",
    "drush/drush": "^13.6",
    "npm-asset/chart.js": "^4.4",
    "npm-asset/chartjs-adapter-date-fns": "^3.0",
    "npm-asset/chartjs-plugin-datalabels": "^2.0",
    "oomphinc/composer-installers-extender": "^2.0"
  },
  "conflict": {
    "drupal/drupal": "*"
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "config": {
    "allow-plugins": {
      "composer/installers": true,
      "cweagans/composer-patches": true,
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "drupal/core-composer-scaffold": true,
      "drupal/core-project-message": true,
      "drupal/core-recipe-unpack": true,
      "oomphinc/composer-installers-extender": true,
      "php-http/discovery": true,
      "php-tuf/composer-integration": true,
      "phpstan/extension-installer": true
    },
    "sort-packages": true
  },
  "extra": {
    "installer-types": [
      "npm-asset",
      "bower-asset"
    ],
    "drupal-scaffold": {
      "locations": {
        "web-root": "web/"
      },
      "allowed-packages": [
        "drupal/claude_code"
      ]
    },
    "installer-paths": {
      "web/core": [
        "type:drupal-core"
      ],
      "web/libraries/{$name}": [
        "type:drupal-library",
        "type:npm-asset",
        "type:bower-asset"
      ],
      "web/modules/contrib/{$name}": [
        "type:drupal-module"
      ],
      "web/profiles/contrib/{$name}": [
        "type:drupal-profile"
      ],
      "web/themes/contrib/{$name}": [
        "type:drupal-theme"
      ],
      "drush/Commands/contrib/{$name}": [
        "type:drupal-drush"
      ],
      "web/modules/custom/{$name}": [
        "type:drupal-custom-module"
      ],
      "web/profiles/custom/{$name}": [
        "type:drupal-custom-profile"
      ],
      "web/themes/custom/{$name}": [
        "type:drupal-custom-theme"
      ],
      "recipes/{$name}": [
        "type:drupal-recipe"
      ]
    },
    "patches": {
      "drupal/group": {
        "More contexts needed (issue #2815971)": "https://git.drupalcode.org/project/group/-/merge_requests/159.diff"
      }
    },
    "enable-patching": true,
    "composer-exit-on-patch-failure": true
  },
  "require-dev": {
    "drupal/claude_code": "^1.0",
    "drupal/coder": "^8.3",
    "slevomat/coding-standard": "^8.20"
  },
  "scripts": {
    "clean-chartjs": "chmod +x scripts/clean-chartjs.sh && ./scripts/clean-chartjs.sh",
    "post-install-cmd": [
      "@clean-chartjs"
    ],
    "post-update-cmd": [
      "@clean-chartjs"
    ]
  }
}
